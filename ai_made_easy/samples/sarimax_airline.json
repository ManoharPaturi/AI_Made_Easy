{
  "schema_version": 1,
  "name": "sarimax_airline",
  "meta": {
    "title": "State-Space \u2014 Seasonal ARIMA",
    "description": "The classic 'airline' model SARIMA(0,1,1)(0,1,1)12 in state-space form: one regular and one seasonal difference with moving-average terms. Compare its forecast and AIC with the structural model on the same kind of series."
  },
  "nodes": [
    {
      "id": "arima",
      "type": "ssm.arima",
      "params": {
        "p": 0,
        "d": 1,
        "q": 1,
        "seasonal_p": 0,
        "seasonal_d": 1,
        "seasonal_q": 1,
        "season": 12,
        "trend": "n"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "model",
      "type": "ssm.model",
      "params": {
        "target_column": "",
        "horizon": 24,
        "interval": 0.9,
        "irregular": true,
        "max_iterations": 200
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "data",
      "type": "data.structural_series",
      "params": {
        "length": 240,
        "slope": 0.05,
        "level_drift": 0.02,
        "season_length": 12,
        "season_amplitude": 2.0,
        "cycle_amplitude": 0.0,
        "noise": 0.4,
        "seed": 0
      },
      "position": [
        0,
        0
      ]
    }
  ],
  "edges": [
    {
      "from": "arima/out",
      "to": "model/components"
    }
  ]
}
