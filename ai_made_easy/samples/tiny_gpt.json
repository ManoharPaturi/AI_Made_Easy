{
 "schema_version": 1,
 "name": "tiny_gpt",
 "meta": {
  "title": "Text \u2014 Tiny GPT Language Model",
  "description": "A 3-layer GPT learns to write toy sentences byte by byte (\"the cat sees a red ball in the park.\"). Live samples show it go from noise to grammar. Swap Synthetic Text for a Text Corpus to train on your own writing."
 },
 "nodes": [
