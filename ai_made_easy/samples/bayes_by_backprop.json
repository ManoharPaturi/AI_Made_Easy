{
  "schema_version": 1,
  "name": "bayes_by_backprop",
  "meta": {
    "title": "Uncertainty \u2014 Bayes by Backprop",
    "description": "Every weight is a Gaussian whose mean and spread are learned; the KL divergence to the prior is added to the loss. Predictions average 30 sampled networks, so confidence drops away from the data."
